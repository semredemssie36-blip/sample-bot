# PostgreSQL connection string — copy .env.example to .env and fill in your credentials
DATABASE_URL="postgresql://username:password@localhost:5432/telegram_tap_game?schema=public"

# Your Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN="your-bot-token-here"

# The public URL where your app is deployed (no trailing slash)
# e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
