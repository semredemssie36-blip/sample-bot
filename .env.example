# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://username:password@host:5432/novadrop?schema=public"

# ── Telegram ─────────────────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN="your-bot-token-here"

# Username of your bot (without @)
NEXT_PUBLIC_BOT_USERNAME="gameaaappbot"

# ── App URL ───────────────────────────────────────────────────────────────────
# Public URL where your Next.js app is deployed (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ── Adsgram ───────────────────────────────────────────────────────────────────
# Block ID from your Adsgram dashboard (https://adsgram.ai)
# Sign up at adsgram.ai, create a block, paste the ID here
NEXT_PUBLIC_ADSGRAM_BLOCK_ID="your-adsgram-block-id"
