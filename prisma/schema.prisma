generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum QuestType {
  DAILY_CHECKIN
  WATCH_AD
  INVITE_FRIENDS
  JOIN_CHANNEL
  JOIN_GROUP
  PLAY_GAME
  SOCIAL_FOLLOW
  CONNECT_WALLET
  REACH_LEVEL
  SPONSORED
}

enum QuestDifficulty {
  EASY
  MEDIUM
  HARD
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum TransactionType {
  TAP_REWARD
  QUEST_REWARD
  REFERRAL_BONUS
  PASSIVE_INCOME
  STREAK_BONUS
  AD_REWARD
  ACHIEVEMENT_BONUS
  WITHDRAWAL
  ADMIN_GRANT
}

enum AchievementType {
  FIRST_TAP
  FIRST_REFERRAL
  STREAK_7
  STREAK_30
  LEVEL_5
  LEVEL_10
  LEVEL_20
  INVITE_5
  INVITE_10
  INVITE_25
  EARN_10K
  EARN_100K
  FIRST_WITHDRAWAL
  WALLET_CONNECTED
  ALL_QUESTS
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id          String   @id
  username    String?
  firstName   String?
  photoUrl    String?

  // Economy
  novaBalance  Int     @default(0)
  totalEarned  Int     @default(0)
  level        Int     @default(1)
  xp           Int     @default(0)
  totalTaps    Int     @default(0)

  // Referral tree
  referralCode   String  @unique
  referredBy     String?           // referralCode of direct inviter

  // TON wallet
  tonWallet   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  energy          Energy?
  userQuests      UserQuest[]
  referrals       Referral[]          @relation("Referrer")
  transactions    Transaction[]
  withdrawals     Withdrawal[]
  streak          DailyStreak?
  achievements    UserAchievement[]
  passiveIncome   PassiveIncome[]     @relation("Recipient")
  passiveGenerated PassiveIncome[]    @relation("Generator")
  gameSessions    GameSession[]
}

// Energy system — tap the coin to earn NOVA
model Energy {
  id          String   @id @default(cuid())
  userId      String   @unique
  current     Int      @default(500)
  maximum     Int      @default(500)
  // Refill rate: 1 energy per 10 seconds
  refillRate  Int      @default(1)      // energy per tick
  refillEvery Int      @default(10)     // seconds per tick
  lastRefillAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model Quest {
  id          String          @id @default(cuid())
  title       String
  description String
  iconEmoji   String          @default("⚡")
  type        QuestType
  difficulty  QuestDifficulty @default(EASY)
  minutesEst  Int             @default(5)

  novaReward  Int
  xpReward    Int

  repeatable  Boolean         @default(false)
  resetHours  Int             @default(24)
  targetCount Int             @default(1)

  // Channel/group verification
  channelUsername String?
  channelUrl      String?

  // Sponsor metadata
  sponsorName String?
  sponsorUrl  String?

  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  userQuests  UserQuest[]
}

model UserQuest {
  id          String   @id @default(cuid())
  userId      String
  questId     String
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  completedAt DateTime?
  claimedAt   DateTime?
  lastReset   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  quest       Quest    @relation(fields: [questId], references: [id])

  @@unique([userId, questId])
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  refereeId    String   @unique
  level        Int      @default(1)    // 1 = direct, 2 = friend-of-friend
  bonusPaid    Boolean  @default(false)
  bonusAmount  Int      @default(500)
  createdAt    DateTime @default(now())

  referrer     User     @relation("Referrer", fields: [referrerId], references: [id])
}

// Passive income — every time a friend earns, you get a % automatically
model PassiveIncome {
  id           String   @id @default(cuid())
  recipientId  String                        // who receives the %
  generatorId  String                        // who earned (the friend)
  level        Int                           // 1 = 10%, 2 = 3%
  amount       Int                           // NOVA credited
  sourceType   String                        // "TAP", "QUEST", "AD", etc.
  createdAt    DateTime @default(now())

  recipient    User     @relation("Recipient",  fields: [recipientId], references: [id])
  generator    User     @relation("Generator",  fields: [generatorId], references: [id])
}

model DailyStreak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastClaimedAt DateTime?
  nextClaimAt   DateTime?

  user          User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Int
  description String
  meta        Json?
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id])
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  novaAmount  Int
  tonAmount   Float
  tonWallet   String
  status      WithdrawalStatus @default(PENDING)
  txHash      String?
  note        String?
  requestedAt DateTime         @default(now())
  processedAt DateTime?

  user        User             @relation(fields: [userId], references: [id])
}

model Achievement {
  id          String          @id @default(cuid())
  type        AchievementType @unique
  title       String
  description String
  iconEmoji   String
  novaReward  Int             @default(0)
  xpReward    Int             @default(0)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model GameSession {
  id        String   @id @default(cuid())
  userId    String
  gameType  String   @default("coin_rush")
  score     Int      @default(0)
  novaEarned Int     @default(0)
  duration  Int      @default(0)  // seconds
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}
